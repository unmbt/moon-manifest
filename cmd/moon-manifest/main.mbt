///|
async fn main {
  let args = @env.args()
  guard args is [_, command, path, .. rest] else {
    fail(
      "usage: moon-manifest version <moon.mod> | generate-version <moon.mod> <output.mbt> [server_version]",
    )
  }
  let source = @fs.read_text(path)
  let document = @manifest.parse(Mod, source, path~)
  guard document.diagnostics.is_empty() else {
    let messages = document.diagnostics
      .map(d => "\{path}: \{d.message}")
      .join("\n")
    fail(messages)
  }
  guard document.version() is Some(version) else {
    fail("missing version in \{path}")
  }
  match (command, rest) {
    ("version", []) => println(version)
    ("version", _) => fail("unexpected arguments for version")
    ("generate-version", [output]) =>
      write_version_file(output, "const VERSION = ", version)
    ("generate-version", [output, "server_version"]) =>
      write_version_file(output, "let server_version : String = ", version)
    ("generate-version", []) => fail("missing output path")
    ("generate-version", _) => fail("unexpected arguments for generate-version")
    _ => fail("unknown command: \{command}")
  }
}

///|
async fn write_version_file(
  output : String,
  declaration : String,
  version : String,
) -> Unit {
  let generated =
    $|// Generated by unmbt/moon-manifest. DO NOT EDIT.
    $|
    $|///|
    $|\{declaration}\{Json::string(version).stringify()}
    $|
  if !@fs.exists(output) || @fs.read_text(output) != generated {
    @fs.write_text(output, generated)
  }
}
