///|
async fn main {
  let args = @env.args()
  guard args is [_, command, path, .. rest] else {
    fail(
      "usage: moon-manifest version <moon.mod> | generate-version <moon.mod> <output.mbt> [server_version]",
    )
  }
  let source = @fs.read_text(path)
  let document = @manifest.parse(@manifest.Mod, source, path~)
  guard document.diagnostics.is_empty() else {
    fail(document.diagnostics[0].message)
  }
  guard document.version() is Some(version) else {
    fail("missing version in " + path)
  }
  if command == "version" {
    println(version)
  } else if command == "generate-version" {
    guard rest is [output, ..] else { fail("missing output path") }
    let name = if rest.length() > 1 && rest[1] == "server_version" {
      "server_version"
    } else {
      "VERSION"
    }
    let declaration = if name == "server_version" {
      "let server_version : String = "
    } else {
      "const VERSION = "
    }
    let generated = "// Generated by unmbt/moon-manifest. DO NOT EDIT.\n\n///|\n" +
      declaration +
      Json::string(version).stringify() +
      "\n"
    if !@fs.exists(output) || @fs.read_text(output) != generated {
      @fs.write_text(output, generated)
    }
  } else {
    fail("unknown command: " + command)
  }
}
